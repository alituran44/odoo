<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-Level Menu -->
    <menuitem id="menu_social_root" name="Sosyal Medya" sequence="15" web_icon="social_media_community,static/description/icon.png"/>

    <!-- Social Account Views -->
    <record id="view_social_account_tree" model="ir.ui.view">
        <field name="name">social.account.tree</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <tree string="Sosyal Medya Hesapları">
                <field name="name"/>
                <field name="platform"/>
                <field name="partner_id"/>
                <field name="profile_url"/>
                <field name="instagram_account_id"/>
            </tree>
        </field>
    </record>

    <record id="view_social_account_form" model="ir.ui.view">
        <field name="name">social.account.form</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <form string="Sosyal Medya Hesabı">
                <sheet>
                    <group>
                        <group string="Hesap &amp; Müşteri Bilgileri">
                            <field name="name"/>
                            <field name="platform"/>
                            <field name="partner_id"/>
                            <field name="profile_url" widget="url"/>
                        </group>
                        <group string="🔑 Meta / Instagram API Jetonları (Tokens)">
                            <field name="instagram_account_id" placeholder="Örn: 17841400000000000"/>
                            <field name="access_token" placeholder="Meta Graph API Long-Lived Access Token yapıştırınız..."/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_social_account" model="ir.actions.act_window">
        <field name="name">Sosyal Medya Hesapları</field>
        <field name="res_model">social.account</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Social Post Views -->
    <record id="view_social_post_kanban" model="ir.ui.view">
        <field name="name">social.post.kanban</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="platform"/>
                <field name="post_type"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><span class="badge text-bg-info"><field name="platform"/></span> - <field name="post_type"/></div>
                                <div><small><strong>Müşteri:</strong> <field name="partner_id"/></small></div>
                                <div><small><strong>Tarih:</strong> <field name="scheduled_date"/></small></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_social_post_form" model="ir.ui.view">
        <field name="name">social.post.form</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <form string="Sosyal Medya Gönderisi">
                <header>
                    <button name="action_publish_to_instagram" string="🚀 Instagram'da Şimdi Yayınla" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,copywriting,design,approval,scheduled,published"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="post_type"/>
                        </group>
                        <group>
                            <field name="platform"/>
                            <field name="scheduled_date"/>
                            <field name="image_url" placeholder="https://ornek.com/gorsel.jpg"/>
                            <field name="image_file" filename="image_filename" widget="image"/>
                            <field name="image_filename" invisible="1"/>
                            <field name="instagram_media_id" readonly="1" invisible="not instagram_media_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Gönderi Metni &amp; Açıklama">
                            <field name="post_content" placeholder="Sosyal medya gönderi metninizi ve hashtag'lerinizi yazınız..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_social_post" model="ir.actions.act_window">
        <field name="name">İçerik Takvimi &amp; Gönderiler</field>
        <field name="res_model">social.post</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Sub-Menus -->
    <menuitem id="menu_social_post" name="İçerik Takvimi &amp; Gönderiler" parent="menu_social_root" action="action_social_post" sequence="10"/>
    <menuitem id="menu_social_account" name="Sosyal Medya Hesapları" parent="menu_social_root" action="action_social_account" sequence="20"/>
</odoo>
